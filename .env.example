NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Keep the service role key out of all NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=
# Generate each value separately with: openssl rand -hex 32
ADMIN_WORKSPACE_KEY=replace-with-long-random-admin-key
MANAGER_WORKSPACE_KEY=replace-with-long-random-manager-key
CASHIER_WORKSPACE_KEY=replace-with-long-random-cashier-key
OWNER_ROUTE_SECRET=replace-with-a-separate-long-random-owner-secret
