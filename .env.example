# MongoDB Atlas or self-hosted MongoDB connection string.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=stock_management_os

# Use a long random secret (32+ bytes) for signed HTTP-only sessions.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-session-secret

# Generate each workspace/owner route key independently.
ADMIN_WORKSPACE_KEY=replace-with-long-random-admin-key
MANAGER_WORKSPACE_KEY=replace-with-long-random-manager-key
CASHIER_WORKSPACE_KEY=replace-with-long-random-cashier-key
OWNER_ROUTE_SECRET=replace-with-a-separate-long-random-owner-secret

# Optional scheduled owner reminder endpoint.
CRON_SECRET=replace-with-another-long-random-secret

# Used only by the one-time Supabase export script (never by the running app).
# Set to the direct PostgreSQL connection string from Supabase Database settings.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
